{
  "Changes": [
    {
      "Target": "Data/AudioChanges",
      "Action": "EditData",
      "Entries": {
        "{{ModId}}_ShopMusic": {
          "Id": "{{ModId}}_ShopMusic",
          "FilePaths": [
            "{{AbsoluteFilePath: assets/radio_1.ogg}}"
          ],
          "Category": "Music",
          "StreamedVorbis": true,
          "Looped": true
        }
      }
    },
    {
      "Target": "Mods/ichortower.PositionalAudio/Data",
      "Action": "EditData",
      "Entries": {
        "{{ModId}}_PA_NormalShop": {
          "Condition": "ichortower.PositionalAudio_NPC_ANIMATING {{Norm}} Here {{Norm}}_counter",
          "CueName": "{{ModId}}_ShopMusic",
          "Location": "Town",
          "MinimumBgmVolume": 0.0,
          "Radius": {
            "Floor": 1.0,
            "Shelf": 3.0,
            "Maximum": 14.0
          },
          "TilePosition": { "X": "{{ShopTileX}}", "Y": "{{ShopTileY}}" }
        }
      },
      "When": {
        "HasFlag: hostPlayer |contains={{ModId}}_MailNotice": true
      }
    },
    {
      "Target": "Data/JukeboxTracks",
      "Action": "EditData",
      "Entries": {
        "{{ModId}}_ShopMusic": {
          "Name": "{{i18n:ShopMusic.Title}}"
        }
      }
    }
  ]
}
