{
  "Format": "2.6.0",
  "ConfigSchema": {
    "PlayMusic": {
      "AllowValues": "true, false",
      "Default": true
    }
  },
  "DynamicTokens": [
    {
      "Name": "Norm",
      "Value": "{{ModId}}_Norm"
    },
    // where the truck parks in Town. it's a rectangle so this coordinate is top-left,
    // off above the truck's actual tiles
    {
      "Name": "Town X",
      "Value": 7
    },
    {
      "Name": "Town Y",
      "Value": 65
    },
    // where norm goes after closing up. at first it's just to the saloon, but he adds
    // a few spots at 4 hearts and chooses one at random.
    // after he asks you where you like to go, he adds one additional spot there to the pool.
    {
      "Name": "FreeTimeString",
      "Value": "Saloon 11 20 0"
    },
    {
      "Name": "FreeTimeString",
      "Value": "Saloon 11 20 0, Town 22 26 1, Beach 22 24 2, Forest 93 39 2",
      "When": {
        "Hearts:{{Norm}}": "4, 5, 6, 7, 8, 9, 10"
      }
    },
    {
      "Name": "FreeTimeString",
      "Value": "{{FreeTimeString}}, Town 78 95 2",
      "When": {
        "HasDialogueAnswer |contains={{ModId}}_QTown": true
      }
    },
    {
      "Name": "FreeTimeString",
      "Value": "{{FreeTimeString}}, Forest 51 32 3",
      "When": {
        "HasDialogueAnswer |contains={{ModId}}_QForest": true
      }
    },
    {
      "Name": "FreeTimeString",
      "Value": "{{FreeTimeString}}, Beach 55 22 2",
      "When": {
        "HasDialogueAnswer |contains={{ModId}}_QBeach": true
      }
    },
    {
      "Name": "FreeTimeSpot",
      "Value": "{{Random: {{FreeTimeString}}}}"
    },
    {
      "Name": "DoorTileX",
      "Value": "{{Query: {{Town X}} + 1}}"
    },
    {
      "Name": "DoorTileY",
      "Value": "{{Query: {{Town Y}} + 4}}"
    },
    {
      "Name": "InsideTileX",
      "Value": "{{Query: {{Town X}} + 4}}"
    },
    {
      "Name": "InsideTileY",
      "Value": "{{Query: {{Town Y}} + 3}}"
    },
    {
      "Name": "ShopTileX",
      "Value": "{{InsideTileX}}"
    },
    {
      "Name": "ShopTileY",
      "Value": "{{DoorTileY}}"
    },
    {
      "Name": "RearTileX",
      "Value": "{{Query: {{Town X}} + 6}}"
    },
    {
      "Name": "RearTileY",
      "Value": "{{Query: {{Town Y}} + 5}}"
    },
    {
      "Name": "RandomGifts",
      "Value": "[{{ModId}}_SoftPretzel {{ModId}}_WhoopiePie {{ModId}}_BirchBeer]"
    }
  ],
  "Changes": [
    {
      "Action": "Include",
      "FromFile": "data/norm.json"
    },
    {
      "Action": "Include",
      "FromFile": "data/objects.json"
    },
    {
      "Action": "Include",
      "FromFile": "data/shop.json"
    },
    {
      "Action": "Include",
      "FromFile": "data/music.json",
      "When": {
        "PlayMusic": true
      }
    }
  ]
}
