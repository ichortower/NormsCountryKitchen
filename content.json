{
  "Format": "2.6.0",
  "ConfigSchema": {
    "PlayMusic": {
      "AllowValues": "true, false",
      "Default": true
    },
    "TruckPalette": {
      "AllowValues": "Auto, Vanilla, Earthy, VPR",
      "Default": "Auto"
    }
  },
  "DynamicTokens": [
    {
      "Name": "Norm",
      "Value": "{{ModId}}_Norm"
    },
    // where the truck parks in Town. it's a rectangle so this coordinate is top-left,
    // off above the truck's actual tiles
    {
      "Name": "Town X",
      "Value": 7
    },
    {
      "Name": "Town Y",
      "Value": 65
    },
    // where the truck parks at the stardew valley fair, years 1 and 2. like town x/y,
    // it's the top left corner of the map patch. see data/shop.json for more math.
    {
      "Name": "Fair1 X",
      "Value": 13
    },
    {
      "Name": "Fair1 Y",
      "Value": 28
    },
    {
      "Name": "Fair2 X",
      "Value": 49
    },
    {
      "Name": "Fair2 Y",
      "Value": 50
    },
    {
      "Name": "Fair2 Y",
      "Value": "{{Query:{{Fair2 Y}} - 1}}",
      "When": {
        "HasMod |contains=FlashShifter.StardewValleyExpandedCP": true
      }
    },
    // where norm goes after closing up. at first it's just to the saloon, but he adds
    // a few spots at 4 hearts and chooses one at random.
    // after he asks you where you like to go, he adds one additional spot there to the pool.
    {
      "Name": "FreeTimeString",
      "Value": "Saloon 11 20 0"
    },
    {
      "Name": "FreeTimeString",
      "Value": "Saloon 11 20 0, Town 22 26 1, Beach 22 24 2, Forest 93 39 2",
      "When": {
        "Hearts:{{Norm}}": "4, 5, 6, 7, 8, 9, 10"
      }
    },
    {
      "Name": "FreeTimeString",
      "Value": "{{FreeTimeString}}, Town 78 95 2",
      "When": {
        "HasDialogueAnswer |contains={{ModId}}_QTown": true
      }
    },
    {
      "Name": "FreeTimeString",
      "Value": "{{FreeTimeString}}, Forest 51 32 3",
      "When": {
        "HasDialogueAnswer |contains={{ModId}}_QForest": true
      }
    },
    {
      "Name": "FreeTimeString",
      "Value": "{{FreeTimeString}}, Beach 55 22 2",
      "When": {
        "HasDialogueAnswer |contains={{ModId}}_QBeach": true
      }
    },
    {
      "Name": "FreeTimeSpot",
      "Value": "{{Random: {{FreeTimeString}}}}"
    },
    // coordinates derived from truck location that some patches use
    {
      "Name": "DoorTileX",
      "Value": "{{Query: {{Town X}} + 1}}"
    },
    {
      "Name": "DoorTileY",
      "Value": "{{Query: {{Town Y}} + 4}}"
    },
    {
      "Name": "InsideTileX",
      "Value": "{{Query: {{Town X}} + 4}}"
    },
    {
      "Name": "InsideTileY",
      "Value": "{{Query: {{Town Y}} + 3}}"
    },
    {
      "Name": "ShopTileX",
      "Value": "{{InsideTileX}}"
    },
    {
      "Name": "ShopTileY",
      "Value": "{{DoorTileY}}"
    },
    {
      "Name": "RearTileX",
      "Value": "{{Query: {{Town X}} + 6}}"
    },
    {
      "Name": "RearTileY",
      "Value": "{{Query: {{Town Y}} + 5}}"
    },
    {
      "Name": "RandomGifts",
      "Value": "[{{ModId}}_SoftPretzel {{ModId}}_WhoopiePie {{ModId}}_BirchBeer]"
    },
    // which palette to apply to truck tilesheet
    {
      "Name": "UseTruckPalette",
      "Value": "{{TruckPalette}}"
    },
    {
      "Name": "UseTruckPalette",
      "Value": "Earthy",
      "When": {
          "UseTruckPalette": "Auto",
          "HasMod": "DaisyNiko.EarthyRecolour"
      }
    },
    {
      "Name": "UseTruckPalette",
      "Value": "VPR",
      "When": {
          "UseTruckPalette": "Auto",
          "HasMod": "grapeponta.VibrantPastoralRecolor"
      }
    },
    {
      "Name": "UseTruckPalette",
      "Value": "Vanilla",
      "When": {
          "UseTruckPalette": "Auto"
      }
    }
  ],
  "Changes": [
    {
      "Action": "Include",
      "FromFile": "data/norm.json"
    },
    {
      "Action": "Include",
      "FromFile": "data/objects.json"
    },
    {
      "Action": "Include",
      "FromFile": "data/shop.json"
    },
    {
      "Action": "Include",
      "FromFile": "data/music.json",
      "When": {
        "PlayMusic": true
      }
    }
  ]
}
